# One wallet pays for the mint and receives the NFTs. Keep the real .env private.
WALLET_KEY=0x<64-hex-character-private-key>

# RPC and transaction settings.
RPC_URL=https://your-chain-rpc.example
RPC_REQUEST_TIMEOUT_MS=10000
FEE_AUTOMATIC=true
# Example only: choose enough gas for the quantity; the tool does not estimate it.
GAS_LIMIT=300000

# MAX_FEE_PER_GAS_GWEI=1.5 # Manual mode: set FEE_AUTOMATIC=false and uncomment both.
# MAX_PRIORITY_FEE_PER_GAS_GWEI=0.1

# Public mint timing. A positive offset sends early and can cause a revert.
PUBLIC_MINT_BROADCAST_OFFSET_MS=0

# Receipt tracking. The mint is not sent again after an uncertain response.
PENDING_TIMEOUT_SECONDS=20
RECEIPT_POLL_INTERVAL_MS=250

# OpenSea internal web-protocol request bounds. Mint actions get a 3-second attempt.
# Attempt counts outside their supported bounds are clamped with a warning.
OPENSEA_REQUEST_TIMEOUT_MS=10000
ELIGIBILITY_REQUEST_TIMEOUT_MS=5000
OPENSEA_ACTION_REQUEST_TIMEOUT_MS=3000
OPENSEA_ATTEMPTS=6
OPENSEA_RETRY_INTERVAL_MS=250
OPENSEA_CALLDATA_ATTEMPTS=15
