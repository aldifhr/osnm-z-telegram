# Copy to bot.env, chmod 600, never commit.
# Kept separate from the app .env because osnm_z.config rejects unknown settings.

# From @BotFather. REVOKE any token that has been pasted into a chat.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram id. In a group this must be the group id.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional extra RPCs, comma separated. Only https:// URLs are accepted.
# OSNM_EXTRA_RPCS=https://mainnet.base.org,https://rpc.mainnet.chain.robinhood.com
